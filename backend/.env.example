# ────────────── Server ──────────────
PORT=5001
NODE_ENV=development

# ────────────── MongoDB ─────────────
MONGODB_URI=mongodb://127.0.0.1:27017/certchain

# ────────────── JWT ─────────────────
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# ────────────── Pinata (IPFS) ───────
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# ────────────── Email (Resend) ──────
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM=CertChain <onboarding@resend.dev>

# ────────────── Blockchain: Sepolia ─
ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
CONTRACT_ADDRESS=0x_YOUR_SEPOLIA_DEPLOYED_CONTRACT_ADDRESS
ADMIN_PRIVATE_KEY=0x_YOUR_SERVER_WALLET_PRIVATE_KEY_NEVER_COMMIT
# Optional: set the Sepolia deploy block to avoid scanning from genesis for audit logs.
CONTRACT_DEPLOY_BLOCK=0
# Optional audit log tuning for RPC free-tier limits.
AUDIT_LOOKBACK_BLOCKS=1000
AUDIT_LOG_BLOCK_WINDOW=10
# Keep false for a smooth dashboard. Set true only when you need a full on-chain log rescan.
AUDIT_SCAN_FROM_DEPLOY=false
# Keep false for fast audit pages. Set true only if you explicitly need live blockchain log enrichment.
AUDIT_ENABLE_CHAIN_EVENTS=false

# ────────────── Frontend ────────────
FRONTEND_URL=http://localhost:3000
PUBLIC_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-production-domain.com
BASE_URL=http://localhost:3000

# ────────────── Default Admin Seed ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123456
