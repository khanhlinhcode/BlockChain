# ────────────── Server ──────────────
PORT=5000
NODE_ENV=development

# ────────────── MongoDB ─────────────
MONGODB_URI=mongodb://127.0.0.1:27017/certchain

# ────────────── JWT ─────────────────
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# ────────────── Pinata (IPFS) ───────
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# ────────────── Blockchain ──────────
ALCHEMY_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_KEY
CONTRACT_ADDRESS=0x_YOUR_DEPLOYED_CONTRACT_ADDRESS
ADMIN_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_NEVER_COMMIT
# Optional: set deployed block to avoid scanning from genesis for audit logs
CONTRACT_DEPLOY_BLOCK=0
# Optional audit log tuning for RPC free-tier limits
AUDIT_LOOKBACK_BLOCKS=300
AUDIT_LOG_BLOCK_WINDOW=10

# ────────────── Frontend ────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-production-domain.com
BASE_URL=http://localhost:5000

# ────────────── Default Admin Seed ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123456
