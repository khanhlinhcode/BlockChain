# Root variables used by Docker Compose scripts.
# For local Hardhat dev, ./scripts/dev-docker.sh overrides most of these.
# For Sepolia dev, ./scripts/dev-sepolia.sh reads backend/.env and smart-contract/.env.

NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_CONTRACT_ADDRESS=0x_YOUR_SEPOLIA_DEPLOYED_CONTRACT_ADDRESS
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_ALCHEMY_KEY=YOUR_KEY
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
NEXT_PUBLIC_ISSUING_ORG=CertChain

FRONTEND_URL=http://localhost:3000
PUBLIC_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
CONTRACT_ADDRESS=0x_YOUR_SEPOLIA_DEPLOYED_CONTRACT_ADDRESS
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM=CertChain <onboarding@resend.dev>
CONTRACT_DEPLOY_BLOCK=0
AUDIT_LOOKBACK_BLOCKS=1000
AUDIT_LOG_BLOCK_WINDOW=10
AUDIT_SCAN_FROM_DEPLOY=false
AUDIT_ENABLE_CHAIN_EVENTS=false
